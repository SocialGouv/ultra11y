{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|bash|shell|local_shell|exec_command|run_command|exec",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
